#!/usr/bin/env bash
# Install brew formulae; batch first, then retry individually so a broken/missing one is skipped.
set -uo pipefail

if brew install --yes "$@"; then
  exit 0
fi

printf '\033[1;4m%s\033[0m\n' "brew: batch failed, retrying individually to skip broken/missing..." >&2
for pkg in "$@"; do
  brew install --yes "$pkg" || echo "brew: failed to install $pkg" >&2
done
