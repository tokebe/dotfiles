#!/usr/bin/env bash
# Install pnpm globals; batch first, then retry individually so a broken/missing one is skipped.
set -uo pipefail

# pnpm needs PNPM_HOME set and on PATH for global ops
export PNPM_HOME="${PNPM_HOME:-$HOME/.pnpm}"
export PATH="$PNPM_HOME/bin:$PATH"

if pnpm add -g --yes "$@"; then
  exit 0
fi

# Fail on single-package failure
if [ "$#" -eq 1 ]; then
  exit 1
fi

printf '\033[1;4m%s\033[0m\n' "pnpm: batch failed, retrying individually to skip broken/missing..." >&2
for pkg in "$@"; do
  pnpm add -g --yes "$pkg" || echo "pnpm: failed to install $pkg" >&2
done
