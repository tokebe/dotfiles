#!/usr/bin/env bash
# Install flatpak apps from flathub
set -uo pipefail

if flatpak install -y flathub "$@"; then
  exit 0
fi

# Fail on single-package failure
if [ "$#" -eq 1 ]; then
  exit 1
fi

printf '\033[1;4m%s\033[0m\n' "flatpak: batch failed, retrying individually to skip broken/missing..." >&2
for app in "$@"; do
  flatpak install -y flathub "$app" || echo "flatpak: failed to install $app" >&2
done
