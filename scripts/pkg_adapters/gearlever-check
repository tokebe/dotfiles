#!/usr/bin/env bash
# Count AppImages with an available update; count to stdout, detail on stderr.
set -uo pipefail

gearlever() { flatpak run it.mijorus.gearlever "$@"; }

updates="$(gearlever --list-updates --json 2>/dev/null)"

jq -c '.updates[]' <<<"$updates" 2>/dev/null >&2 || true
jq -r '.updates | length' <<<"$updates" 2>/dev/null || echo 0
