# This one can be messy because a lot of auto-integration gets slapped in here

# FZF Integration
command -v fzf >/dev/null && source <(fzf --zsh)
fzf_inline_opts='--height="~50%" --prompt="▎󰥨 "
--info="inline-right" --no-separator
--preview-window="border-sharp"
--gutter="▎"
--color="gutter:8"
--scrollbar="▐"
--preview="ctpv {}"'
export FZF_ALT_C_OPTS="$fzf_inline_opts"
export FZF_CTRL_T_OPTS="$fzf_inline_opts"
export FZF_CTRL_R_OPTS='--height="~50%" --prompt="▎ "
--info="inline-right" --no-separator
--gutter="▎" --color="gutter:8"
--scrollbar="▐" --layout="reverse"'

## fzf-integration tweaks
bindkey '^R' custom-fzf-hist  # autoloaded; rebinds over fzf --zsh's ^R
# ^T (fzf-file-widget) and alt-c (fzf-cd-widget) keep fzf's native bindings from above

# Use bat for manpager
export MANPAGER=$HOME/.batman

# Navi integration
command -v navi >/dev/null && eval "$(navi widget zsh | sed -e 's/\^g/\^n/')"

# fx configuration https://github.com/antonmedv/fx
export FX_SHOW_SIZE=true
export FX_LINE_NUMBERS=true

# walk config
export WALK_REMOVE_CMD='gtrash put'

# jump
command -v jump >/dev/null && eval "$(jump shell)"

# nvm (node) — interactive only; heavy to source, and hooks get node via bash
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
