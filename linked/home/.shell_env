# Shared PATH / build env for POSIX shells

export GOPATH="$HOME/gocode"
export PNPM_HOME="$HOME/.pnpm"

# Prepend an existing dir to PATH if it isn't already present
_dots_path_prepend() {
  [ -d "$1" ] || return 0
  case ":$PATH:" in
    *":$1:"*) ;;
    *) PATH="$1:$PATH" ;;
  esac
}

# Prepended low-to-high priority
_dots_path_prepend "$HOME/.pyenv/shims"
_dots_path_prepend "$GOPATH/bin"
_dots_path_prepend "$HOME/.cargo/bin"
_dots_path_prepend "$HOME/.local/bin"
case "$(uname -s)" in
  Linux) _dots_path_prepend "/home/linuxbrew/.linuxbrew/bin" ;;
  Darwin) _dots_path_prepend "/opt/homebrew/bin" ;;
esac
export PATH
unset -f _dots_path_prepend

# pnpm's global bin
case ":$PATH:" in *":$PNPM_HOME/bin:"*) ;; *) export PATH="$PNPM_HOME/bin:$PATH" ;; esac

# pkg-config dirs for native builds (cargo/C); add only those present, keep any existing value
for _pc in /usr/lib64/pkgconfig /usr/lib/pkgconfig /usr/lib/x86_64-linux-gnu/pkgconfig /usr/lib/aarch64-linux-gnu/pkgconfig; do
  [ -d "$_pc" ] || continue
  case ":${PKG_CONFIG_PATH:-}:" in
    *":$_pc:"*) ;;
    *) PKG_CONFIG_PATH="${PKG_CONFIG_PATH:+$PKG_CONFIG_PATH:}$_pc" ;;
  esac
done
[ -n "${PKG_CONFIG_PATH:-}" ] && export PKG_CONFIG_PATH
unset _pc

# Ensure flatpak path
if [ "$(uname -s)" = "Linux" ]; then
  XDG_DATA_DIRS="${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
  for _fp in /var/lib/flatpak/exports/share "$HOME/.local/share/flatpak/exports/share"; do
    case ":$XDG_DATA_DIRS:" in
      *":$_fp:"*) ;;
      *) XDG_DATA_DIRS="$XDG_DATA_DIRS:$_fp" ;;
    esac
  done
  export XDG_DATA_DIRS
  unset _fp
fi

# Integrate with dots: autojump to dir when called with no subcommand
dots() {
  if [ "$#" -eq 0 ]; then
    command dots --help
    cd "$(command dots root)" || return
  else
    command dots "$@"
  fi
}
