#! /usr/bin/env zsh

# Magic-enter dashboard, for useful info in a given dir

rule() {
  print -- ${(l:COLUMNS::─:)}
}

if [[ $OSTYPE == "linux-gnu"* ]]; then
  disk_use="$(df -h --output="target,pcent,avail" . | tail -1)"

  mem_use="$(free -h)"
  mem_total="$(echo $mem_use | awk 'NR==2{print $2}')"
  mem_used="$(echo $mem_use | awk 'NR==2{print $3}')"

  os_icon="󰌽 "

  system_uptime=$(uptime -p | sed 's/./\u&/')
elif [[ $OSTYPE == "darwin"* ]]; then
  disk_use="$(gdf -h --output="target,pcent,avail" . | tail -1)"

  memsize_bytes=$(sysctl -n hw.memsize)
  mem_total=$(expr $memsize_bytes / $((1024**3)))
  memuse_gb=$(ps -A -o %mem, | awk -v mem_total=$mem_total '{ mem += $1} END {print mem / 100 * mem_total}')
  mem_used=$(printf "%.2f\n" "$memuse_gb" )

  os_icon=" "

  system_uptime=$(uptime | sed -n 's/^.*up  \([^,]*\).*/\1/p')
fi

mnt="$(echo $disk_use| awk '{print $1}')"
pcent="$(echo $disk_use| awk '{print $2}')"
avail="$(echo $disk_use| awk '{print $3}')"

if command -v >/dev/null 2>&1 hyfetch;
then
  os_icon=$(hyfetch --print-font-logo)
  os_icon+=" "
fi

topline=" $os_icon   $system_uptime    $mem_used / $mem_total  󰋊  $mnt $pcent ($avail Available) "

echo

image_path="$HOME/Filen_Local/wallpaper/images/ilya-kuvshinov-helmet.jpg"

if [ -e "$image_path" ]; then
  fastfetch \
    --sixel "$image_path" \
    --logo-height 9 \
    --logo-padding-left 1 \
    --logo-padding-right 1 \
    -s title:host:cpu:gpu:os:kernel:wm:colors
else
  fastfetch \
    --logo small \
    --logo-padding-left 1 \
    --logo-padding-right 2 \
    -s title:host:cpu:gpu:os:kernel:wm:colors
fi
echo

echo "\e[7m$topline\e[0m"

# Git info
if [[ $1 = "git" ]]; then
  echo "ORIGIN $(git remote get-url origin)"
  git --no-pager log --oneline --decorate=short -3 --graph
  rule
  git --no-pager diff --stat
  rule
fi

lsd -AX --group-dirs=first
