### Font
font-family = "Tokebe Nerd Font"
font-style = "Medium"
font-size = 18
adjust-cell-height = 10%

### Appearance
theme = light:Rose Pine Dawn,dark:Rose Pine Moon
cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true
shell-integration-features = no-cursor
background-opacity = 0.95
background-blur = true
window-padding-balance = true
window-decoration = client
window-show-tab-bar = never
macos-titlebar-style = hidden
macos-window-buttons = hidden

### Behavior
mouse-scroll-multiplier = 0.5
scrollback-limit = 100000
link-previews = true
quit-after-last-window-closed = true
# confirm-close-surface = false

### Quick Terminal
quick-terminal-screen = mouse
gtk-quick-terminal-namespace = quick-terminal-overlay
quick-terminal-position = center
quick-terminal-size = 30%,60%

# custom-shader = ./shaders/glow-rgbsplit-twitchy.glsl
# custom-shader = ./shaders/bettercrt.glsl
# ustom-shader = ./shaders/cursor_blaze.glsl

keybind = global:cmd+backquote=toggle_quick_terminal
