workspace "main"
workspace "util" {
    layout {
        gaps 32
        struts {
            top 128
            bottom 128
        }
    }

}

window-rule {
    match at-startup=true app-id="Filen"
    match app-id="Filen"
    match app-id="com.rafaelmardojai.Blanket"
    open-on-workspace "util"

}
